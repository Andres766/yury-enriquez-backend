// ════════════════════════════════════════════════════════════════════
//  Esquema de base de datos — Estudio de maquillaje y peinado
//  Postgres + Prisma. Todas las fechas se guardan en UTC; la zona
//  horaria del negocio vive en Settings.timezone y la conversión se
//  hace en la capa de servicio (src/lib/time.js).
// ════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────

enum Role {
  CLIENT
  ADMIN
}

enum ServiceCategory {
  MAQUILLAJE
  PEINADO
  PAQUETE
  TALLER
}

/// Cómo se muestra el precio de un servicio.
///   FIXED — precio cerrado ("$120.000")
///   FROM  — precio de partida ("Desde $120.000"): varía según el caso
///   QUOTE — sin precio público: se cotiza por WhatsApp
enum PriceMode {
  FIXED
  FROM
  QUOTE
}

enum BookingStatus {
  PENDING // creada por el cliente, a la espera de confirmación
  CONFIRMED // confirmada por la maquilladora
  COMPLETED // servicio prestado (habilita el sello de fidelidad)
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  TRANSFERENCIA
  EFECTIVO
}

enum DiscountType {
  PERCENT
  AMOUNT
}

/// Tema visual del sitio publico. Solo lo cambia la administradora
/// desde el panel: las visitantes no tienen selector.
enum SiteTheme {
  LIGHT
  DARK
  HALLOWEEN
}

enum RewardStatus {
  AVAILABLE
  REDEEMED
  EXPIRED
}

// ── Usuarios y sesiones ─────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  fullName       String
  phone          String?
  role           Role     @default(CLIENT)
  marketingOptIn Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bookings      Booking[]
  loyaltyCard   LoyaltyCard?
  refreshTokens RefreshToken[]
  grantedStamps LoyaltyStamp[] @relation("StampGrantedBy")

  @@index([role])
}

/// Solo se guarda el hash del refresh token: si la base se filtra,
/// los tokens siguen sin ser utilizables.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ── Catálogo ────────────────────────────────────────────────────────

model Service {
  id               String          @id @default(cuid())
  slug             String          @unique
  name             String
  category         ServiceCategory
  shortDescription String
  description      String
  durationMinutes  Int
  priceCents       Int
  currency         String          @default("COP")
  active           Boolean         @default(true)
  featured         Boolean         @default(false)
  sortOrder        Int             @default(0)
  priceMode        PriceMode       @default(FIXED)
  /// Viñetas de "Qué incluye" (en orden).
  includes         String[]        @default([])
  /// Si se fija, reemplaza a Settings.maxAdvanceDays para este servicio:
  /// las novias reservan con muchos meses de anticipación.
  maxAdvanceDays   Int?
  /// Temporada del servicio (YYYY-MM-DD, ambas inclusive, en la zona del
  /// negocio). Si se fijan, solo se puede reservar para días dentro de
  /// ese rango, aunque la reserva se haga antes (catrinas: 22–31 oct).
  availableFrom    String?
  availableUntil   String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  images    ServiceImage[]
  bookings  Booking[]
  occasions ServiceOccasion[]

  @@index([category, active])
}

model ServiceImage {
  id        String @id @default(cuid())
  serviceId String
  url       String
  alt       String
  sortOrder Int    @default(0)
  /// Punto que no se recorta (CSS object-position), p. ej. "50% 30%".
  focus     String @default("50% 50%")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

/// "Para cada ocasión": bodas, quinceañeros, grados, etc.
model Occasion {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String
  description String
  includes    String[] // viñetas de "qué incluye"
  heroImage   String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services ServiceOccasion[]
  bookings Booking[]
}

model ServiceOccasion {
  serviceId  String
  occasionId String

  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  occasion Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)

  @@id([serviceId, occasionId])
  @@index([occasionId])
}

model Promotion {
  id            String       @id @default(cuid())
  title         String
  description   String
  code          String?      @unique
  discountType  DiscountType @default(PERCENT)
  discountValue Int
  image         String?
  startsAt      DateTime
  endsAt        DateTime
  active        Boolean      @default(true)
  membersOnly   Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([active, startsAt, endsAt])
}

// ── Disponibilidad ──────────────────────────────────────────────────

/// Horario semanal recurrente. weekday sigue la convención de Luxon:
/// 1 = lunes ... 7 = domingo. startTime/endTime en formato "HH:mm",
/// interpretados en la zona horaria del negocio.
model AvailabilityRule {
  id        String   @id @default(cuid())
  weekday   Int
  startTime String
  endTime   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weekday, active])
}

/// Bloqueos puntuales: día no laborable completo o una franja concreta.
model TimeBlock {
  id        String   @id @default(cuid())
  startAt   DateTime
  endAt     DateTime
  allDay    Boolean  @default(false)
  reason    String?
  createdAt DateTime @default(now())

  @@index([startAt, endAt])
}

// ── Reservas ────────────────────────────────────────────────────────

model Booking {
  id            String        @id @default(cuid())
  /// Código corto legible para que un invitado consulte su reserva.
  code          String        @unique
  serviceId     String
  occasionId    String?
  /// Null cuando la reserva se hizo como invitado (sin cuenta).
  userId        String?
  customerName  String
  customerEmail String
  customerPhone String
  notes         String?
  /// Dónde se presta el servicio. Yury trabaja 100 % a domicilio.
  serviceAddress String?
  adminNotes    String?
  startAt       DateTime
  endAt         DateTime
  status        BookingStatus @default(PENDING)
  paymentMethod PaymentMethod
  priceCents    Int
  currency      String        @default("COP")
  createdIp     String?
  /// De dónde llegó la clienta (utm_source / ref del enlace), si se sabe.
  source        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  confirmedAt   DateTime?
  cancelledAt   DateTime?
  completedAt   DateTime?

  service  Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  occasion Occasion?     @relation(fields: [occasionId], references: [id], onDelete: SetNull)
  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  stamp    LoyaltyStamp?

  @@index([startAt])
  @@index([status, startAt])
  @@index([customerEmail])
  @@index([userId])
}

// ── Fidelidad ───────────────────────────────────────────────────────

model LoyaltyCard {
  id            String   @id @default(cuid())
  userId        String   @unique
  /// Sellos del ciclo en curso (se reinicia al desbloquear recompensa).
  stampsCurrent Int      @default(0)
  /// Sellos históricos acumulados, nunca se reinicia.
  stampsTotal   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  stamps  LoyaltyStamp[]
  rewards LoyaltyReward[]
}

/// Un sello por servicio completado. Solo lo otorga la maquilladora
/// desde el panel: nunca se genera automáticamente al crear la reserva.
model LoyaltyStamp {
  id          String   @id @default(cuid())
  cardId      String
  bookingId   String?  @unique
  note        String?
  grantedById String
  createdAt   DateTime @default(now())

  card      LoyaltyCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  booking   Booking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  grantedBy User        @relation("StampGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)

  @@index([cardId])
}

model LoyaltyReward {
  id          String       @id @default(cuid())
  cardId      String
  description String
  status      RewardStatus @default(AVAILABLE)
  unlockedAt  DateTime     @default(now())
  redeemedAt  DateTime?
  createdAt   DateTime     @default(now())

  card LoyaltyCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, status])
}

// ── Ajustes del negocio (fila única, id = 1) ────────────────────────

model Settings {
  id                     Int      @id @default(1)
  brandName              String   @default("Yury Enríquez")
  tagline                String   @default("Makeup Artist")
  aboutText              String   @default("")
  contactEmail           String   @default("")
  contactPhone           String   @default("")
  whatsappNumber         String   @default("")
  instagramUrl           String?
  tiktokUrl              String?
  facebookUrl            String?
  addressLine            String   @default("")
  mapUrl                 String?
  businessHoursNote      String   @default("")
  ownerNotificationEmail String   @default("")
  transferInstructions   String   @default("")
  /// Porcentaje del valor que se abona para separar la fecha (0–100).
  /// Null = no se muestra ninguna política de abono.
  depositPercent         Int?
  /// Adicional del domicilio dentro del perímetro urbano, en centavos.
  /// Null = no se muestra. Fuera de la ciudad se cotiza aparte.
  homeVisitFeeCents      Int?
  /// Fotos del inicio que Yury cambia desde el panel. Null = las de serie.
  heroImageUrl           String?
  heroImageAlt           String?
  heroImageFocus         String?
  aboutImageUrl          String?
  aboutImageAlt          String?
  aboutImageFocus        String?
  theme                  SiteTheme @default(LIGHT)
  /// Tema de temporada programado. Entre seasonalStartDate y
  /// seasonalEndDate (YYYY-MM-DD, ambos inclusive, en `timezone`) la web
  /// pública muestra este tema en vez de `theme`.
  seasonalTheme          SiteTheme?
  seasonalStartDate      String?
  seasonalEndDate        String?
  timezone               String   @default("America/Bogota")
  slotIntervalMinutes    Int      @default(30)
  bufferMinutes          Int      @default(15)
  minNoticeHours         Int      @default(12)
  maxAdvanceDays         Int      @default(90)
  stampsRequired         Int      @default(8)
  rewardDescription      String   @default("Maquillaje social de cortesía")
  updatedAt              DateTime @updatedAt
}

// ── Testimonios ─────────────────────────────────────────────────────

/// Opiniones de clientas que la administradora publica a mano. No se
/// recogen solas desde la web: así no hay spam ni reseñas inventadas.
model Testimonial {
  id            String   @id @default(cuid())
  name          String
  /// "Novia · marzo 2026", "Quinceañera", etc. Libre.
  occasionLabel String   @default("")
  quote         String
  /// 1 a 5, opcional.
  rating        Int?
  photoUrl      String?
  published     Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published, sortOrder])
}

// ── Biblioteca de fotos ─────────────────────────────────────────────

/// Todas las fotos que Yury administra desde el panel: las que sube a
/// Cloudinary y las que venían con la web (/img/trabajos/…, importadas).
/// La galería «Mi trabajo» muestra las que tienen inGallery = true.
model Photo {
  id        String   @id @default(cuid())
  /// public_id de Cloudinary. Null en las fotos que vienen con la web.
  publicId  String?  @unique
  /// secure_url de Cloudinary o ruta del propio sitio ("/img/…").
  url       String
  width     Int?
  height    Int?
  bytes     Int?
  alt       String   @default("")
  /// novias | quinceaneras | social | temporada (categorías de la galería)
  category  String?
  inGallery Boolean  @default(true)
  featured  Boolean  @default(false)
  /// Punto que no se recorta (CSS object-position)
  focus     String   @default("50% 50%")
  /// Crédito visible, p. ej. "Foto: Silvio Maya Fotografía"
  credit    String?
  /// Sale una persona menor de edad (requiere autorización del acudiente)
  minor     Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inGallery, category, sortOrder])
}

