# ─────────────────────────────────────────────────────────────
#  SERVIDOR
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# URL publica del frontend (usada en los enlaces de los correos)
APP_URL=http://localhost:5173
# Origenes permitidos por CORS, separados por coma. SIN comodines.
CORS_ORIGINS=http://localhost:5173

# Confiar en el proxy inverso (1 = un salto, ej. Nginx/Render/Railway).
# Necesario para que el rate limiting lea la IP real. Dejar en 0 sin proxy.
TRUST_PROXY=0

# ─────────────────────────────────────────────────────────────
#  BASE DE DATOS
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/estudio_belleza?schema=public"

# ─────────────────────────────────────────────────────────────
#  SEGURIDAD / TOKENS
#  Genera cada secreto con:  openssl rand -base64 48
#  NUNCA reutilices estos valores de ejemplo en produccion.
# ─────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-access
JWT_REFRESH_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Dominio de las cookies en produccion (ej. .midominio.com). Vacio en local.
COOKIE_DOMAIN=
# lax | strict | none  ("none" exige HTTPS y secure=true)
COOKIE_SAMESITE=lax

# ─────────────────────────────────────────────────────────────
#  CORREO
#  MAIL_DRIVER=console  -> imprime los correos por consola (desarrollo)
#  MAIL_DRIVER=smtp     -> envia de verdad usando las credenciales SMTP
#  MAIL_DRIVER=resend   -> envia por la API HTTP de Resend (para Render Free,
#                          que bloquea SMTP). Requiere RESEND_API_KEY.
# ─────────────────────────────────────────────────────────────
MAIL_DRIVER=console
MAIL_FROM="Yury Enríquez <reservas@tudominio.com>"
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=
RESEND_API_KEY=

# ─────────────────────────────────────────────────────────────
#  SEED (solo para poblar datos de prueba)
# ─────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@yuryenriquez.com
SEED_ADMIN_PASSWORD=Admin.2026Segura
SEED_ADMIN_NAME="Yury Enríquez"
SEED_CLIENT_EMAIL=cliente@ejemplo.com
SEED_CLIENT_PASSWORD=Cliente.2026Segura
