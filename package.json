{
  "name": "estudio-belleza-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API de reservas para estudio de maquillaje y peinado",
  "engines": { "node": ">=20" },
  "prisma": { "seed": "node prisma/seed.js" },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:constraints": "prisma db execute --file prisma/sql/constraints.sql --schema prisma/schema.prisma",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "setup": "npm run db:generate && npm run db:migrate && npm run db:constraints && npm run db:seed"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "argon2": "^0.41.1",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.5.0",
    "morgan": "^1.10.0",
    "nanoid": "^5.0.9",
    "nodemailer": "^6.9.16",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^6.2.1"
  }
}
